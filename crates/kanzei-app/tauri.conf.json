{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kanzei",
  "version": "0.1.0",
  "identifier": "dev.kanzei.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "kanzei",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 500,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
