[
  {
    "key": "architecture_boundaries",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/architecture-boundaries-smoke.mjs"
    ],
    "paths": [
      "Cargo.toml",
      "Cargo.lock",
      "crates/**",
      "scripts/architecture-boundaries*",
      "AGENTS.md",
      "CONTRIBUTING.md"
    ],
    "resources": [
      "cargo"
    ]
  },
  {
    "key": "esm_test_imports",
    "inputs": "always",
    "program": "node",
    "args": [
      "--experimental-vm-modules",
      "scripts/esm-test-imports-smoke.mjs"
    ],
    "paths": [
      "scripts/esm-test-imports*"
    ]
  },
  {
    "key": "verify_policy",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/verify-policy-smoke.mjs"
    ],
    "paths": [
      "scripts/verify*",
      "scripts/verification-checks.json",
      "scripts/package.ps1"
    ]
  },
  {
    "key": "verify_runner",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/verify-runner-smoke.mjs"
    ],
    "paths": [
      "scripts/verify*",
      "scripts/verification-checks.json"
    ]
  },
  {
    "key": "artifact_lifecycle",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/artifact-lifecycle-smoke.mjs"
    ],
    "paths": [
      "scripts/artifact-lifecycle*",
      "scripts/cache-lock.ps1",
      "scripts/dev.ps1",
      "scripts/package.ps1",
      "scripts/release.ps1"
    ]
  },
  {
    "key": "native_fixture_lifecycle",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/native-fixture-lifecycle-smoke.mjs"
    ],
    "paths": [
      "scripts/native-fixture*",
      "scripts/desktop-helper.ps1",
      "scripts/artifact-lifecycle*"
    ]
  },
  {
    "key": "design_freshness",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/check-design-freshness.mjs",
      "--self-test"
    ]
  },
  {
    "key": "crate_sync",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/check-readme-crates.mjs"
    ]
  },
  {
    "key": "ps1_bom",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/check-ps1-bom.mjs"
    ]
  },
  {
    "key": "ipc_signatures",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/sync-ipc-contract.mjs",
      "--check"
    ],
    "paths": [
      "crates/kanzei-app/src/**/*.rs",
      "crates/kanzei-app/src/command_registry.json",
      "crates/kanzei-app/build*",
      "crates/kanzei-app/Cargo.toml",
      "crates/kanzei-app/web/src/ipc/generated.ts",
      "Cargo.toml",
      "Cargo.lock",
      "scripts/ipc*",
      "scripts/sync-ipc-contract.mjs"
    ],
    "resources": [
      "cargo"
    ]
  },
  {
    "key": "ipc_event_contract",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/ipc-event-smoke.mjs"
    ]
  },
  {
    "key": "ipc_arguments",
    "inputs": "always",
    "program": "node",
    "args": [
      "scripts/ipc-arguments-smoke.mjs"
    ]
  },
  {
    "key": "ui_typecheck",
    "inputs": "frontend",
    "program": "node",
    "args": [
      "node_modules/typescript/bin/tsc",
      "-p",
      "crates/kanzei-app/web/tsconfig.json",
      "--noEmit"
    ],
    "paths": [
      "crates/kanzei-app/web/**",
      "package.json"
    ]
  },
  {
    "key": "ui_lint",
    "inputs": "frontend",
    "program": "node",
    "args": [
      "node_modules/eslint/bin/eslint.js",
      "crates/kanzei-app/web/src"
    ],
    "paths": [
      "crates/kanzei-app/web/src/**",
      "scripts/*.mjs",
      "eslint.config.js"
    ]
  },
  {
    "key": "ui_unit_tests",
    "inputs": "frontend",
    "program": "node",
    "args": [
      "node_modules/vitest/vitest.mjs",
      "run",
      "--config",
      "crates/kanzei-app/web/vitest.config.ts"
    ],
    "paths": [
      "crates/kanzei-app/web/**"
    ]
  },
  {
    "key": "ui_build",
    "inputs": "frontend",
    "program": "node",
    "args": [
      "node_modules/vite/bin/vite.js",
      "build",
      "--config",
      "crates/kanzei-app/web/vite.config.ts"
    ],
    "paths": [
      "crates/kanzei-app/web/**",
      "package.json"
    ]
  },
  {
    "key": "ui_e2e_edge",
    "inputs": "frontend",
    "program": "node",
    "args": [
      "scripts/ui-window-chrome-smoke.mjs"
    ],
    "depends_on": [
      "ui_build"
    ],
    "resources": [
      "browser"
    ],
    "paths": [
      "crates/kanzei-app/web/**",
      "scripts/ui-window-chrome-smoke.mjs"
    ]
  },
  {
    "key": "fmt",
    "inputs": "rust",
    "program": "cargo",
    "args": [
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "resources": [
      "cargo"
    ]
  },
  {
    "key": "clippy",
    "inputs": "rust",
    "program": "cargo",
    "args": [
      "clippy",
      "--workspace",
      "--",
      "-D",
      "warnings"
    ],
    "resources": [
      "cargo"
    ]
  },
  {
    "key": "test",
    "inputs": "rust",
    "program": "cargo",
    "args": [
      "test",
      "--workspace"
    ],
    "resources": [
      "cargo",
      "host"
    ]
  }
]
