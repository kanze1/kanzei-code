      "root_owner": "crates/kanzei-app/src/preview/agent.rs",
      "change": "面板等待动作锁后复核原generation、owner epoch、process与页面URL；A→B→A同URL也拒绝旧动作。",
      "regression": "queued_action_rejects_rebinding_and_recreated_pane_even_at_same_url",
      "status": "fixed_regressions_passed",
      "trigger": "A 的 browser 动作已选中面板，等待另一个父/子代理动作释放 agent 锁；用户切换到 B，可见性命令将面板绑定 B。",
      "impact": "A 后续获得锁仍操作当前 B 面板。服务桥只比 URL，同页切会话无法拦截。"
    }
